# PostgreSQL Database
DATABASE_URL=postgresql://supportflow_user:supportflow_password@postgres:5432/supportflow

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
TICKET_QUEUE_NAME=supportflow:ticket_queue

# LLM providers, tried in order; a provider with no key is skipped.
# Gemini is only used when Groq is rate-limited or down.
LLM_PROVIDERS=groq,gemini
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash

# Knowledge base retrieval: re-rank vector hits with a local cross-encoder
# (BAAI/bge-reranker-base, ~1 GB download on first use). 0 = vector order only.
RAG_RERANK=1

# JWT Authentication
JWT_SECRET=your-secret-key-here-min-32-chars
JWT_ALGORITHM=HS256

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=supportflow

# Rate limiting (Redis). Limits return 429 with a Retry-After; the token budget is
# shared by the API and the worker and sized just under the Groq free tier
# (8,000 tokens/minute, 200,000/day). Set a token window to 0 to disable it.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_PER_MINUTE=10
TOKEN_BUDGET_PER_MINUTE=7000
TOKEN_BUDGET_PER_DAY=180000

# Policy-answer cache (Redis): off by default so evaluation runs measure the model.
# A repeated question over the same policy text is answered without a model call.
ANSWER_CACHE_ENABLED=0
ANSWER_CACHE_TTL_SECONDS=3600
# Load the embedding and re-ranking models at startup (the first search takes ~12 s cold).
WARM_UP_MODELS=1
# Seconds before the first retry of a transient ticket failure (doubles each time, max 30).
WORKER_RETRY_BACKOFF_SECONDS=1
