  "metadata": {
    "experiment_name": "Banking Transaction Taxonomy Correction",
    "experiment_date": "2026-09-13",
    "baseline_accuracy": "50.0% (77/154)",
    "hypothesis": "Current low Order Issue accuracy (2.6%, 1/38) is caused by mapping banking transaction-state problems to Order Issue instead of Billing",
    "changes_proposed": 16,
    "cases_affected": 34,
    "semantic_principle": "Banking transactions (payments, transfers, withdrawals, top-ups) with status/authorization/posting problems should map to Billing, not Order Issue. Order Issue should only include physical delivery problems.",
    "source": "mteb/banking77",
    "license": "CC-BY-4.0",
    "total_intents": 77,
